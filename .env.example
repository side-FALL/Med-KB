# 医学教材知识库环境变量模板
# 复制此文件为 .env 并填入真实密钥
# cp .env.example .env

## CherryIN API 密钥
CS_API_KEY=your_cherryin_api_key_here

## mimo API 密钥
MIMO_API_KEY=your_mimo_api_key_here

## 火山方舟 API 密钥
ARK_API_KEY=your_ark_api_key_here

# 魔搭社区访问令牌
Med-kb=your_modelscope_token_here

# 付费模型访问密码
PASSWORD=your_password_here

# JSONBin密钥
JSONBIN_BIN_ID=your_jsonbin_bin_id_here
JSONBIN_API_KEY=your_jsonbin_api_key_here
